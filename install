#!/usr/bin/env bash
set -euo pipefail

REPO="${MAKCODE_REPO:-Shahnawazpathan/makcode-dev}"
VERSION="${VERSION:-latest}"
INSTALL_DIR="${MAKCODE_INSTALL_DIR:-$HOME/.local/bin}"

OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"

case "$OS" in
  darwin) OS="darwin" ;;
  linux) OS="linux" ;;
  *) echo "Unsupported OS: $OS"; exit 1 ;;
esac

case "$ARCH" in
  arm64|aarch64) ARCH="arm64" ;;
  x86_64|amd64) ARCH="x64" ;;
  *) echo "Unsupported arch: $ARCH"; exit 1 ;;
esac

mkdir -p "$INSTALL_DIR"

if [ "$VERSION" = "latest" ]; then
  BASE_URL="https://github.com/$REPO/releases/latest/download"
else
  BASE_URL="https://github.com/$REPO/releases/download/$VERSION"
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

if [ "$OS" = "darwin" ]; then
  ASSET="makcode-$OS-$ARCH.zip"
  curl -fsSL "$BASE_URL/$ASSET" -o "$TMP/$ASSET"
  unzip -q "$TMP/$ASSET" -d "$TMP"
else
  ASSET="makcode-$OS-$ARCH.tar.gz"
  curl -fsSL "$BASE_URL/$ASSET" -o "$TMP/$ASSET"
  tar -xzf "$TMP/$ASSET" -C "$TMP"
fi

install -m 755 "$TMP/makcode" "$INSTALL_DIR/makcode"

echo "MakCode installed to $INSTALL_DIR/makcode"
echo "Run: makcode"
